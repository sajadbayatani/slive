OPENROUTER_API_KEY=

# Local TURN relay (coturn, see docker-compose.yml + README "Local TURN").
# TURN_SERVER is what Slive and the browsers use; prefer it over TURN_SERVERS.
# TURN_HOST must be reachable from the BROWSERS (laptop LAN IP/hostname when
# testing locally — never a Docker container IP on Docker Desktop).
# TURN_SERVER=turn:192.168.1.10:3478
# TURN_USERNAME=slive
# TURN_PASSWORD=change-me-before-running
# TURN_REALM=slive.local
